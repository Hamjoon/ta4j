  {
    "group": "Amount handling \u2013 barSeries.one() is passed correctly",
    "cases": [
      {
        "input": [
          {
            "parameter": "strategy",
            "value": "strategyMock"
          },
          {
            "parameter": "tradeType",
            "value": "TradeType.BUY"
          },
          {
            "parameter": "startIndex",
