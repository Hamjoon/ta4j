      },
      {
        "input": [
          {
            "parameter": "rawPrice",
            "value": "DecimalNum.valueOf(\"-4\")"
          },
          {
            "parameter": "holdingCost",
            "value": "DecimalNum.valueOf(\"-3\")"
          },
          {
            "parameter": "isLongTrade",
            "value": "false"
          }
        ],
        "expected": "DecimalNum.valueOf(\"-7\")",
