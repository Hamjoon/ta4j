          },
          {
            "parameter": "isLongTrade",
            "value": "true"
          }
        ],
        "expected": "NullPointerException",
        "description": "Passing null for rawPrice should result in a NullPointerException."
      },
      {
        "input": [
          {
            "parameter": "rawPrice",
            "value": "DecimalNum.valueOf(\"1\")"
          },
          {
            "parameter": "holdingCost",
            "value": "null"
          },
          {
            "parameter": "isLongTrade",
            "value": "false"
          }
        ],
        "expected": "NullPointerException",
        "description": "Passing null for holdingCost should result in a NullPointerException."
      },
      {
        "input": [
          {
            "parameter": "rawPrice",
            "value": "DecimalNum.valueOf(\"10\")"
          },
          {
            "parameter": "holdingCost",
