      {
        "input": [
          {
            "parameter": "rawPrice",
            "value": "DecimalNum.valueOf(\"0\")"
          },
          {
            "parameter": "holdingCost",
            "value": "DecimalNum.valueOf(\"5\")"
          },
          {
            "parameter": "isLongTrade",
            "value": "false"
          }
        ],
        "expected": "DecimalNum.valueOf(\"5\")",
