      },
      {
        "input": [
          {
            "parameter": "rawPrice",
            "value": "DecimalNum.valueOf(\"-1000000000\")"
          },
          {
            "parameter": "holdingCost",
            "value": "DecimalNum.valueOf(\"999999999\")"
          },
          {
            "parameter": "isLongTrade",
            "value": "false"
          }
        ],
        "expected": "DecimalNum.valueOf(\"-1\")",
        "description": "Short trade with very large negative raw price and large positive holding cost, net price should be -1."
