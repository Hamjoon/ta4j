          },
          {
            "parameter": "isLongTrade",
            "value": "true"
          }
        ],
        "expected": "DecimalNum.valueOf(\"12\")",
        "description": "Long trade with a negative holding cost: net price = rawPrice - (-holdingCost) = 10 + 2 = 12."
