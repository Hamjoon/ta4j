[
  {
    "group": "Buy position gross return calculations",
    "cases": [
      {
        "input": [
          {
            "parameter": "entryPrice",
            "value": "DecimalNum.valueOf(\"100\")"
          },
          {
            "parameter": "exitPrice",
            "value": "DecimalNum.valueOf(\"150\")"
          }
        ],
        "expected": "DecimalNum.valueOf(\"1.5\")",
        "description": "Entry trade is a BUY. Exit price is higher than entry price, so gross return = exit/entry = 150/100 = 1.5."
      },
      {
        "input": [
          {
            "parameter": "entryPrice",
            "value": "DecimalNum.valueOf(\"200\")"
          },
          {
            "parameter": "exitPrice",
            "value": "DecimalNum.valueOf(\"200\")"
          }
        ],
        "expected": "DecimalNum.valueOf(\"1\")",
        "description": "Buy position with no price change. Gross return should be exactly 1."
      },
      {
        "input": [
          {
            "parameter": "entryPrice",
            "value": "DecimalNum.valueOf(\"120\")"
          },
          {
            "parameter": "exitPrice",
            "value": "DecimalNum.valueOf(\"90\")"
          }
        ],
        "expected": "DecimalNum.valueOf(\"0.75\")",
        "description": "Buy position with a loss. Gross return = 90/120 = 0.75 (< 1)."
      },
      {
        "input": [
          {
            "parameter": "entryPrice",
            "value": "DecimalNum.valueOf(\"0\")"
          },
          {
            "parameter": "exitPrice",
            "value": "DecimalNum.valueOf(\"100\")"
          }
        ],
        "expected": "ArithmeticException",
        "description": "Entry price is zero; division by zero should raise an ArithmeticException (or return NaN depending on Num implementation). The test verifies that an exception is thrown."
      }
    ]
  },
  {
    "group": "Sell position gross return calculations",
    "cases": [
      {
        "input": [
          {
            "parameter": "entryPrice",
            "value": "DecimalNum.valueOf(\"200\")"
          },
          {
            "parameter": "exitPrice",
            "value": "DecimalNum.valueOf(\"150\")"
          }
        ],
        "expected": "DecimalNum.valueOf(\"1.25\")",
        "description": "Entry trade is a SELL. Exit price is lower than entry price, producing a profit. Gross return = 2 - (exit/entry) = 2 - (150/200) = 2 - 0.75 = 1.25."
      },
      {
        "input": [
          {
            "parameter": "entryPrice",
            "value": "DecimalNum.valueOf(\"100\")"
          },
          {
            "parameter": "exitPrice",
            "value": "DecimalNum.valueOf(\"150\")"
          }
        ],
        "expected": "DecimalNum.valueOf(\"0.5\")",
        "description": "Entry trade is a SELL. Exit price is higher than entry price, producing a loss. Gross return = 2 - (150/100) = 2 - 1.5 = 0.5."
      },
      {
        "input": [
          {
            "parameter": "entryPrice",
            "value": "DecimalNum.valueOf(\"120\")"
          },
          {
            "parameter": "exitPrice",
            "value": "DecimalNum.valueOf(\"120\")"
          }
        ],
        "expected": "DecimalNum.valueOf(\"1\")",
        "description": "SELL position with no price change. Gross return should be exactly 1 (2 - 1)."
      },
      {
        "input": [
          {
            "parameter": "entryPrice",
            "value": "DecimalNum.valueOf(\"0\")"
          },
          {
            "parameter": "exitPrice",
            "value": "DecimalNum.valueOf(\"100\")"
          }
        ],
        "expected": "ArithmeticException",
        "description": "Entry price is zero for a SELL position; division by zero should raise an ArithmeticException."
      }
    ]
  },
  {
    "group": "Zero price edge cases",
    "cases": [
      {
        "input": [
          {
            "parameter": "entryPrice",
            "value": "DecimalNum.valueOf(\"100\")"
          },
          {
            "parameter": "exitPrice",
            "value": "DecimalNum.valueOf(\"0\")"
          }
        ],
        "expected": "DecimalNum.valueOf(\"0\")",
        "description": "BUY position where exit price is zero. Gross return = 0/100 = 0."
      },
      {
        "input": [
          {
            "parameter": "entryPrice",
            "value": "DecimalNum.valueOf(\"100\")"
          },
          {
            "parameter": "exitPrice",
            "value": "DecimalNum.valueOf(\"0\")"
          }
        ],
        "expected": "DecimalNum.valueOf(\"2\")",
        "description": "SELL position where exit price is zero. Gross return = 2 - (0/100) = 2."
      }
    ]
  },
  {
    "group": "NaN handling",
    "cases": [
      {
        "input": [
          {
            "parameter": "entryPrice",
            "value": "NaN"
          },
          {
            "parameter": "exitPrice",
            "value": "DecimalNum.valueOf(\"100\")"
          }
        ],
        "expected": "NaN",
        "description": "Entry price is NaN; any arithmetic with NaN should result in NaN."
      },
      {
        "input": [
          {
            "parameter": "entryPrice",
            "value": "DecimalNum.valueOf(\"100\")"
          },
          {
            "parameter": "exitPrice",
            "value": "NaN"
          }
        ],
        "expected": "NaN",
        "description": "Exit price is NaN; the gross return should propagate NaN."
      }
    ]
  },
  {
    "group": "Null entry price handling",
    "cases": [
      {
        "input": [
          {
            "parameter": "entryPrice",
            "value": null
          },
          {
            "parameter": "exitPrice",
            "value": "DecimalNum.valueOf(\"100\")"
          }
        ],
        "expected": "NullPointerException",
        "description": "entryPrice is null; the method should throw a NullPointerException before any arithmetic is performed (both BUY and SELL branches)."
      }
    ]
  },
  {
    "group": "Null exit price handling",
    "cases": [
      {
        "input": [
          {
            "parameter": "entryPrice",
            "value": "DecimalNum.valueOf(\"100\")"
          },
          {
            "parameter": "exitPrice",
            "value": null
          }
        ],
        "expected": "NullPointerException",
        "description": "exitPrice is null; the method should throw a NullPointerException when attempting to call dividedBy on a null reference (both BUY and SELL branches)."
      }
    ]
  },
  {
    "group": "Buy position zero\u2011zero division",
    "cases": [
      {
        "input": [
          {
            "parameter": "entryPrice",
            "value": "DecimalNum.valueOf(\"0\")"
          },
          {
            "parameter": "exitPrice",
            "value": "DecimalNum.valueOf(\"0\")"
          }
        ],
        "expected": "ArithmeticException",
        "description": "Both entryPrice and exitPrice are zero for a BUY position; exitPrice.dividedBy(entryPrice) results in a division\u2011by\u2011zero and must raise ArithmeticException."
      }
    ]
  },
  {
    "group": "Sell position zero\u2011zero division",
    "cases": [
      {
        "input": [
          {
            "parameter": "entryPrice",
            "value": "DecimalNum.valueOf(\"0\")"
          },
          {
            "parameter": "exitPrice",
            "value": "DecimalNum.valueOf(\"0\")"
          }
        ],
        "expected": "ArithmeticException",
        "description": "Both entryPrice and exitPrice are zero for a SELL position; the internal division (exitPrice.dividedBy(entryPrice)) triggers a division\u2011by\u2011zero and must raise ArithmeticException."
      }
    ]
  }
]