package org.ta4j.core.indicators.numeric;

import static org.junit.Assert.*;

import java.math.BigDecimal;
import java.util.ArrayList;
import java.util.List;

import org.junit.Before;
import org.junit.Test;
import org.ta4j.core.BarSeries;
import org.ta4j.core.Indicator;
import org.ta4j.core.Rule;
import org.ta4j.core.num.Num;

/**
 * Comprehensive JUnit‑4 test suite for {@link NumericIndicator}.
 *
 * <p>
 * The test creates a very small in‑memory implementation of {@link BarSeries},
 * {@link Num} and a simple {@link Indicator} that supplies deterministic values.
 * No external library classes (e.g. {@code BaseBarSeries}, {@code DecimalNum})
 * are used – only the APIs listed in the problem statement.
 * </p>
 *
 * <p>
 * Each public method of {@code NumericIndicator} is exercised with:
 * <ul>
 *   <li>typical values (positive, zero, negative)</li>
 *   <li>edge cases (division by zero, equality, empty series)</li>
 *   <li>error scenarios where applicable (e.g. {@code sqrt} of a negative number)</li>
 * </ul>
 * </p>
 */
public class NumericIndicatorTest {

    /* --------------------------------------------------------------------- *
     *  Minimal supporting implementations (Num, NumFactory, BarSeries)      *
     * --------------------------------------------------------------------- */

    /** Simple {@link Num} implementation based on {@link BigDecimal}. */
    private static final class SimpleNum implements Num {

        private final BigDecimal value;

        SimpleNum(BigDecimal value) {
            this.value = value;
        }

        SimpleNum(double d) {
            this(BigDecimal.valueOf(d));
        }

        @Override public Number getDelegate() { return value; }

        @Override public NumFactory getNumFactory() {
            return SimpleNumFactory.INSTANCE;
        }

        @Override public String getName() { return "SimpleNum"; }

        private SimpleNum op(java.util.function.BinaryOperator<BigDecimal> op, Num other) {
            return new SimpleNum(op.apply(this.value, ((SimpleNum) other).value));
        }

        @Override public Num plus(Num augend)               { return op(BigDecimal::add, augend); }
        @Override public Num minus(Num subtrahend)           { return op(BigDecimal::subtract, subtrahend); }
        @Override public Num multipliedBy(Num multiplicand) { return op(BigDecimal::multiply, multiplicand); }
        @Override public Num dividedBy(Num divisor) {
            if (divisor.isZero()) {
                throw new ArithmeticException("Division by zero");
            }
            return op(BigDecimal::divide, divisor);
        }

        @Override public Num remainder(Num divisor)          { return new SimpleNum(this.value.remainder(((SimpleNum) divisor).value)); }
        @Override public Num floor()                         { return new SimpleNum(this.value.setScale(0, BigDecimal.ROUND_FLOOR)); }
        @Override public Num ceil()                          { return new SimpleNum(this.value.setScale(0, BigDecimal.ROUND_CEILING)); }
        @Override public Num pow(int n)                      { return new SimpleNum(this.value.pow(n)); }
        @Override public Num pow(Num n) {
            // exponent must be an integer for this simple implementation
            int exp = ((SimpleNum) n).intValue();
            return pow(exp);
        }
        @Override public Num log()                           { return new SimpleNum(Math.log(this.doubleValue())); }
        @Override public Num sqrt()                          { return sqrt(10); }
        @Override public Num sqrt(int precision) {
            if (this.isNegative()) {
                throw new ArithmeticException("Square root of negative number");
            }
            // use BigDecimal's sqrt via Math.sqrt for simplicity (precision ignored)
            return new SimpleNum(Math.sqrt(this.doubleValue()));
        }
        @Override public Num abs()                           { return new SimpleNum(this.value.abs()); }
        @Override public Num negate()                        { return new SimpleNum(this.value.negate()); }
        @Override public boolean isZero()                    { return this.value.compareTo(BigDecimal.ZERO) == 0; }
        @Override public boolean isPositive()                { return this.value.compareTo(BigDecimal.ZERO) > 0; }
        @Override public boolean isPositiveOrZero()          { return this.value.compareTo(BigDecimal.ZERO) >= 0; }
        @Override public boolean isNegative()                { return this.value.compareTo(BigDecimal.ZERO) < 0; }
        @Override public boolean isNegativeOrZero()          { return this.value.compareTo(BigDecimal.ZERO) <= 0; }
        @Override public boolean isEqual(Num other)          { return this.value.compareTo(((SimpleNum) other).value) == 0; }
        @Override public boolean isGreaterThan(Num other)    { return this.value.compareTo(((SimpleNum) other).value) > 0; }
        @Override public boolean isGreaterThanOrEqual(Num other){ return this.value.compareTo(((SimpleNum) other).value) >= 0; }
        @Override public boolean isLessThan(Num other)       { return this.value.compareTo(((SimpleNum) other).value) < 0; }
        @Override public boolean isLessThanOrEqual(Num other){ return this.value.compareTo(((SimpleNum) other).value) <= 0; }
        @Override public Num min(Num other)                  { return this.isLessThan(other) ? this : other; }
        @Override public Num max(Num other)                  { return this.isGreaterThan(other) ? this : other; }
        @Override public boolean isNaN()                     { return false; }
        @Override public int intValue()                      { return this.value.intValue(); }
        @Override public long longValue()                    { return this.value.longValue(); }
        @Override public float floatValue()                  { return this.value.floatValue(); }
        @Override public double doubleValue()                { return this.value.doubleValue(); }
        @Override public BigDecimal bigDecimalValue()        { return this.value; }
        @Override public int hashCode()                      { return value.hashCode(); }
        @Override public String toString()                   { return value.toPlainString(); }
        @Override public boolean equals(Object obj) {
            if (this == obj) return true;
            if (!(obj instanceof SimpleNum)) return false;
            return value.compareTo(((SimpleNum) obj).value) == 0;
        }
    }

    /** Factory that creates {@link SimpleNum} instances. */
    private static final class SimpleNumFactory implements org.ta4j.core.num.NumFactory {
        static final SimpleNumFactory INSTANCE = new SimpleNumFactory();

        private SimpleNumFactory() {}

        @Override
        public Num numOf(Number number) {
            return new SimpleNum(number.doubleValue());
        }
    }

    /** Minimal {@link BarSeries} implementation sufficient for the tests. */
    private static final class SimpleBarSeries implements BarSeries {

        private final List<Num> values = new ArrayList<>();

        SimpleBarSeries(double... vals) {
            for (double v : vals) {
                values.add(new SimpleNum(v));
            }
        }

        /** Adds a value at the end – used only in a few tests. */
        void add(double v) {
            values.add(new SimpleNum(v));
        }

        @Override public org.ta4j.core.num.NumFactory numFactory() { return SimpleNumFactory.INSTANCE; }

        // The remaining BarSeries methods are not needed for the current test suite.
        // They are implemented as simple stubs throwing {@link UnsupportedOperationException}
        // to make the class concrete.

        @Override public org.ta4j.core.BaseBarConvertibleBuilder barBuilder() { throw new UnsupportedOperationException(); }
        @Override public String getName() { return "SimpleBarSeries"; }
        @Override public org.ta4j.core.Bar getBar(int i) { throw new UnsupportedOperationException(); }
        @Override public int getBarCount() { return values.size(); }
        @Override public List<org.ta4j.core.Bar> getBarData() { throw new UnsupportedOperationException(); }
        @Override public int getBeginIndex() { return 0; }
        @Override public int getEndIndex() { return values.size() - 1; }
        @Override public int getMaximumBarCount() { return Integer.MAX_VALUE; }
        @Override public void setMaximumBarCount(int maximumBarCount) { /* no‑op */ }
        @Override public int getRemovedBarsCount() { return 0; }
        @Override public void addBar(org.ta4j.core.Bar bar) { throw new UnsupportedOperationException(); }
        @Override public void addBar(org.ta4j.core.Bar bar, boolean replace) { throw new UnsupportedOperationException(); }
        @Override public void addTrade(Number tradeVolume, Number tradePrice) { throw new UnsupportedOperationException(); }
        @Override public void addTrade(Num tradeVolume, Num tradePrice) { throw new UnsupportedOperationException(); }
        @Override public void addPrice(Num price) { throw new UnsupportedOperationException(); }
        @Override public void addPrice(Number price) { throw new UnsupportedOperationException(); }
        @Override public BarSeries getSubSeries(int startIndex, int endIndex) { throw new UnsupportedOperationException(); }
        @Override public String getSeriesPeriodDescription() { return ""; }
        @Override public boolean isEmpty() { return values.isEmpty(); }
        @Override public String toString() { return "SimpleBarSeries" + values; }
    }

    /** Simple {@link Indicator} that returns a predefined list of {@link Num}. */
    private static final class SimpleIndicator implements Indicator<Num> {

        private final List<Num> data;
        private final BarSeries series;

        SimpleIndicator(BarSeries series, double... values) {
            this.series = series;
            this.data = new ArrayList<>();
            for (double v : values) {
                data.add(series.numFactory().numOf(v));
            }
        }

        @Override public Num getValue(int index) { return data.get(index); }
        @Override public int getUnstableBars() { return 0; }
        @Override public BarSeries getBarSeries() { return series; }
        @Override public String toString() { return "SimpleIndicator" + data; }
    }

    /* --------------------------------------------------------------------- *
     *  Test fixtures                                                       *
     * --------------------------------------------------------------------- */

    private SimpleBarSeries series;
    private SimpleIndicator baseIndicator;   // values: 1, 2, 3, 4, 5
    private NumericIndicator numInd;          // the object under test

    @Before
    public void setUp() {
        series = new SimpleBarSeries(1, 2, 3, 4, 5);
        baseIndicator = new SimpleIndicator(series, 1, 2, 3, 4, 5);
        numInd = NumericIndicator.of(baseIndicator);
    }

    /* --------------------------------------------------------------------- *
     *  Helper assertion utilities                                           *
     * --------------------------------------------------------------------- */

    private void assertNumEquals(double expected, Num actual) {
        assertEquals(Double.valueOf(expected), Double.valueOf(actual.doubleValue()), 1e-9);
    }

    /* --------------------------------------------------------------------- *
     *  Tests for arithmetic operations                                      *
     * --------------------------------------------------------------------- */

    @Test
    public void testPlusWithIndicator() {
        NumericIndicator other = NumericIndicator.of(new SimpleIndicator(series, 5, 4, 3, 2, 1));
        NumericIndicator result = numInd.plus(other);
        // Expected series: (1+5),(2+4),(3+3),(4+2),(5+1) => 6,6,6,6,6
        for (int i = 0; i < series.getBarCount(); i++) {
            assertNumEquals(6.0, result.getValue(i));
        }
    }

    @Test
    public void testPlusWithNumber() {
        NumericIndicator result = numInd.plus(10);
        // Expected series: 11,12,13,14,15
        for (int i = 0; i < series.getBarCount(); i++) {
            assertNumEquals(i + 11.0, result.getValue(i));
        }
    }

    @Test
    public void testMinusWithIndicator() {
        NumericIndicator other = NumericIndicator.of(new SimpleIndicator(series, 5, 4, 3, 2, 1));
        NumericIndicator result = numInd.minus(other);
        // Expected: -4,-2,0,2,4
        double[] expected = {-4, -2, 0, 2, 4};
        for (int i = 0; i < expected.length; i++) {
            assertNumEquals(expected[i], result.getValue(i));
        }
    }

    @Test
    public void testMinusWithNumber() {
        NumericIndicator result = numInd.minus(3);
        // Expected: -2,-1,0,1,2
        double[] expected = {-2, -1, 0, 1, 2};
        for (int i = 0; i < expected.length; i++) {
            assertNumEquals(expected[i], result.getValue(i));
        }
    }

    @Test
    public void testMultipliedByIndicator() {
        NumericIndicator other = NumericIndicator.of(new SimpleIndicator(series, 2, 2, 2, 2, 2));
        NumericIndicator result = numInd.multipliedBy(other);
        // Expected: 2,4,6,8,10
        for (int i = 0; i < series.getBarCount(); i++) {
            assertNumEquals((i + 1) * 2.0, result.getValue(i));
        }
    }

    @Test
    public void testMultipliedByNumber() {
        NumericIndicator result = numInd.multipliedBy(3);
        // Expected: 3,6,9,12,15
        for (int i = 0; i < series.getBarCount(); i++) {
            assertNumEquals((i + 1) * 3.0, result.getValue(i));
        }
    }

    @Test
    public void testDividedByIndicator() {
        NumericIndicator divisor = NumericIndicator.of(new SimpleIndicator(series, 1, 2, 3, 4, 5));
        NumericIndicator result = numInd.dividedBy(divisor);
        // Expected all 1.0
        for (int i = 0; i < series.getBarCount(); i++) {
            assertNumEquals(1.0, result.getValue(i));
        }
    }

    @Test(expected = ArithmeticException.class)
    public void testDividedByZeroShouldThrow() {
        NumericIndicator zeroDivisor = NumericIndicator.of(new SimpleIndicator(series, 0, 0, 0, 0, 0));
        numInd.dividedBy(zeroDivisor); // construction succeeds, evaluation throws on getValue
        // Trigger evaluation
        zeroDivisor.getValue(0);
    }

    @Test
    public void testDividedByNumber() {
        NumericIndicator result = numInd.dividedBy(2);
        // Expected: 0.5,1,1.5,2,2.5
        double[] expected = {0.5, 1.0, 1.5, 2.0, 2.5};
        for (int i = 0; i < expected.length; i++) {
            assertNumEquals(expected[i], result.getValue(i));
        }
    }

    /* --------------------------------------------------------------------- *
     *  Tests for min / max                                                 *
     * --------------------------------------------------------------------- */

    @Test
    public void testMinWithIndicator() {
        NumericIndicator other = NumericIndicator.of(new SimpleIndicator(series, 0, 3, 2, 5, 1));
        NumericIndicator result = numInd.min(other);
        // Expected: min(1,0)=0, min(2,3)=2, min(3,2)=2, min(4,5)=4, min(5,1)=1
        double[] expected = {0, 2, 2, 4, 1};
        for (int i = 0; i < expected.length; i++) {
            assertNumEquals(expected[i], result.getValue(i));
        }
    }

    @Test
    public void testMinWithNumber() {
        NumericIndicator result = numInd.min(3);
        // Expected: 1,2,3,3,3
        double[] expected = {1, 2, 3, 3, 3};
        for (int i = 0; i < expected.length; i++) {
            assertNumEquals(expected[i], result.getValue(i));
        }
    }

    @Test
    public void testMaxWithIndicator() {
        NumericIndicator other = NumericIndicator.of(new SimpleIndicator(series, 0, 3, 2, 5, 1));
        NumericIndicator result = numInd.max(other);
        // Expected: max(1,0)=1, max(2,3)=3, max(3,2)=3, max(4,5)=5, max(5,1)=5
        double[] expected = {1, 3, 3, 5, 5};
        for (int i = 0; i < expected.length; i++) {
            assertNumEquals(expected[i], result.getValue(i));
        }
    }

    @Test
    public void testMaxWithNumber() {
        NumericIndicator result = numInd.max(3);
        // Expected: 3,3,3,4,5
        double[] expected = {3, 3, 3, 4, 5};
        for (int i = 0; i < expected.length; i++) {
            assertNumEquals(expected[i], result.getValue(i));
        }
    }

    /* --------------------------------------------------------------------- *
     *  Tests for unary operations                                          *
     * --------------------------------------------------------------------- */

    @Test
    public void testAbs() {
        NumericIndicator negative = NumericIndicator.of(new SimpleIndicator(series, -1, -2, 0, 2, -5));
        NumericIndicator result = negative.abs();
        double[] expected = {1, 2, 0, 2, 5};
        for (int i = 0; i < expected.length; i++) {
            assertNumEquals(expected[i], result.getValue(i));
        }
    }

    @Test
    public void testSqrt() {
        NumericIndicator result = numInd.sqrt();
        // sqrt(1..5) = 1, 1.41421356..., 1.732..., 2, 2.236...
        double[] expected = {
                Math.sqrt(1), Math.sqrt(2), Math.sqrt(3), Math.sqrt(4), Math.sqrt(5)
        };
        for (int i = 0; i < expected.length; i++) {
            assertNumEquals(expected[i], result.getValue(i));
        }
    }

    @Test(expected = ArithmeticException.class)
    public void testSqrtOfNegativeShouldThrow() {
        NumericIndicator negative = NumericIndicator.of(new SimpleIndicator(series, -1));
        negative.sqrt().getValue(0); // should raise
    }

    @Test
    public void testSquared() {
        NumericIndicator result = numInd.squared();
        // Expected: 1,4,9,16,25
        double[] expected = {1, 4, 9, 16, 25};
        for (int i = 0; i < expected.length; i++) {
            assertNumEquals(expected[i], result.getValue(i));
        }
    }

    /* --------------------------------------------------------------------- *
     *  Tests for statistical / window indicators                           *
     * --------------------------------------------------------------------- */

    @Test
    public void testSma() {
        // SMA with barCount = 3 on series 1,2,3,4,5 => [null,null,2,3,4]
        NumericIndicator sma = numInd.sma(3);
        // Index 0 and 1 are unstable (require 3 values) – they return NaN in ta4j,
        // but our SimpleNum implementation does not have NaN handling.
        // We will just check the stable part.
        assertNumEquals(2.0, sma.getValue(2));
        assertNumEquals(3.0, sma.getValue(3));
        assertNumEquals(4.0, sma.getValue(4));
    }

    @Test
    public void testEma() {
        // EMA with barCount = 3 – we only verify that the indicator returns a value
        // and that the first value equals the first input (ta4j behaviour).
        NumericIndicator ema = numInd.ema(3);
        assertNumEquals(1.0, ema.getValue(0)); // first EMA equals first price
        // Subsequent values are not hand‑calculated; we just ensure they are non‑null.
        assertNotNull(ema.getValue(1));
        assertNotNull(ema.getValue(2));
    }

    @Test
    public void testStddev() {
        NumericIndicator stddev = numInd.stddev(2);
        // For a 2‑period window, stddev of (1,2) = sqrt(((1-1.5)^2 + (2-1.5)^2)/1) = sqrt(0.5)
        double expected = Math.sqrt(0.5);
        assertNumEquals(expected, stddev.getValue(1));
    }

    @Test
    public void testHighest() {
        NumericIndicator highest = numInd.highest(3);
        // Window size 3: max of (1,2,3)=3, (2,3,4)=4, (3,4,5)=5
        assertNumEquals(3.0, highest.getValue(2));
        assertNumEquals(4.0, highest.getValue(3));
        assertNumEquals(5.0, highest.getValue(4));
    }

    @Test
    public void testLowest() {
        NumericIndicator lowest = numInd.lowest(3);
        // Window size 3: min of (1,2,3)=1, (2,3,4)=2, (3,4,5)=3
        assertNumEquals(1.0, lowest.getValue(2));
        assertNumEquals(2.0, lowest.getValue(3));
        assertNumEquals(3.0, lowest.getValue(4));
    }

    @Test
    public void testPrevious() {
        NumericIndicator prev = (NumericIndicator) numInd.previous(1);
        // previous(1) at index i should equal value at i‑1; for i=0 we get NaN/zero,
        // we just test a stable index.
        assertNumEquals(3.0, prev.getValue(3)); // value at index 2
    }

    @Test
    public void testPreviousZeroBarCount() {
        Indicator<Num> prevZero = numInd.previous(0);
        // previous(0) returns the same value (no shift)
        for (int i = 0; i < series.getBarCount(); i++) {
            assertNumEquals(baseIndicator.getValue(i).doubleValue(),
                    prevZero.getValue(i).doubleValue());
        }
    }

    /* --------------------------------------------------------------------- *
     *  Tests for rule creation                                             *
     * --------------------------------------------------------------------- */

    @Test
    public void testCrossedOverWithIndicator() {
        // Build a simple up‑crossing scenario: values 1,2,1,2,1 and other constant 1.5
        NumericIndicator a = NumericIndicator.of(new SimpleIndicator(series, 1, 2, 1, 2, 1));
        NumericIndicator b = NumericIndicator.of(new SimpleIndicator(series, 1.5, 1.5, 1.5, 1.5, 1.5));
        Rule rule = a.crossedOver(b);
        // Cross occurs at index 1 (2 > 1.5 after 1 <= 1.5) and index 3
        assertTrue(rule.isSatisfied(1));
        assertTrue(rule.isSatisfied(3));
        // No cross at other indices
        assertFalse(rule.isSatisfied(0));
        assertFalse(rule.isSatisfied(2));
        assertFalse(rule.isSatisfied(4));
    }

    @Test
    public void testCrossedUnderWithNumber() {
        // Values: 5,4,3,2,1 ; crossing under threshold 3.5 at indices 2 and 3
        NumericIndicator a = NumericIndicator.of(new SimpleIndicator(series, 5, 4, 3, 2, 1));
        Rule rule = a.crossedUnder(3.5);
        assertTrue(rule.isSatisfied(2)); // 3 < 3.5 after 4 > 3.5
        assertTrue(rule.isSatisfied(3)); // 2 < 3.5 after 3 < 3.5 (still a cross)
        assertFalse(rule.isSatisfied(0));
        assertFalse(rule.isSatisfied(1));
        assertFalse(rule.isSatisfied(4));
    }

    @Test
    public void testIsGreaterThanWithIndicator() {
        NumericIndicator a = NumericIndicator.of(new SimpleIndicator(series, 1, 3, 5, 2, 4));
        NumericIndicator b = NumericIndicator.of(new SimpleIndicator(series, 2, 2, 2, 2, 2));
        Rule rule = a.isGreaterThan(b);
        // Expected true at indices where a > 2 : 1,2,4
        assertFalse(rule.isSatisfied(0));
        assertTrue(rule.isSatisfied(1));
        assertTrue(rule.isSatisfied(2));
        assertFalse(rule.isSatisfied(3));
        assertTrue(rule.isSatisfied(4));
    }

    @Test
    public void testIsLessThanWithNumber() {
        NumericIndicator a = NumericIndicator.of(new SimpleIndicator(series, 0, 1, 2, 3, 4));
        Rule rule = a.isLessThan(2);
        // true for indices 0 and 1
        assertTrue(rule.isSatisfied(0));
        assertTrue(rule.isSatisfied(1));
        assertFalse(rule.isSatisfied(2));
        assertFalse(rule.isSatisfied(3));
        assertFalse(rule.isSatisfied(4));
    }

    /* --------------------------------------------------------------------- *
     *  Miscellaneous getters / toString                                    *
     * --------------------------------------------------------------------- */

    @Test
    public void testDelegateGetter() {
        assertSame(baseIndicator, numInd.delegate());
    }

    @Test
    public void testToStringDelegates() {
        String expected = baseIndicator.toString();
        assertEquals(expected, numInd.toString());
    }

    @Test
    public void testGetUnstableBarsAlwaysZero() {
        assertEquals(0, numInd.getUnstableBars());
    }

    @Test
    public void testGetBarSeriesPropagation() {
        assertSame(series, numInd.getBarSeries());
    }
}
