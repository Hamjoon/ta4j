/**
 * Comprehensive JUnit‑4 test suite for {@link org.ta4j.core.indicators.numeric.NumericIndicator}.
 *
 * <p>All tests are written using only the public API that appears in the supplied
 * source code or in the dependency signatures.  No mocking frameworks are used;
 * instead a very small in‑memory implementation of {@link org.ta4j.core.BarSeries},
 * {@link org.ta4j.core.num.Num} and {@link org.ta4j.core.num.NumFactory} is provided.
 *
 * <p>The tests cover:
 * <ul>
 *   <li>Arithmetic fluent methods (plus, minus, multipliedBy, dividedBy, min, max, abs, sqrt, squared)</li>
 *   <li>Statistical/technical indicator factories (sma, ema, stddev, highest, lowest, previous)</li>
 *   <li>Rule factories (crossedOver, crossedUnder, isGreaterThan, isLessThan)</li>
 *   <li>Delegate forwarding (getValue, getBarSeries, toString)</li>
 *   <li>Typical, edge and error scenarios (division by zero, negative sqrt, equal values for min/max)</li>
 * </ul>
 *
 * The test class is deliberately self‑contained so it can be compiled and run
 * against the original library without any external test utilities.
 */
package org.ta4j.core.indicators.numeric;

import org.junit.Before;
import org.junit.Test;
import org.ta4j.core.BarSeries;
import org.ta4j.core.Indicator;
import org.ta4j.core.Rule;
import org.ta4j.core.num.Num;
import org.ta4j.core.num.NumFactory;

import java.math.BigDecimal;
import java.util.ArrayList;
import java.util.Collections;
import java.util.List;

import static org.junit.Assert.*;

/**
 * Minimal {@link Num} implementation that wraps a {@code double}.
 * It implements all methods required by the tests (the rest delegate to the
 * underlying {@code double} value).  This is sufficient because the library
 * only uses the methods defined in the public {@link Num} interface.
 */
class SimpleNum implements Num {
    private final double value;

    SimpleNum(double value) {
        this.value = value;
    }

    @Override public Number getDelegate()                     { return value; }
    @Override public NumFactory getNumFactory()               { return SimpleNumFactory.INSTANCE; }
    @Override public String getName()                          { return Double.toString(value); }
    @Override public Num plus(Num augend)                     { return new SimpleNum(this.value + augend.doubleValue()); }
    @Override public Num minus(Num subtrahend)                 { return new SimpleNum(this.value - subtrahend.doubleValue()); }
    @Override public Num multipliedBy(Num multiplicand)      { return new SimpleNum(this.value * multiplicand.doubleValue()); }
    @Override public Num dividedBy(Num divisor)                { return new SimpleNum(this.value / divisor.doubleValue()); }
    @Override public Num remainder(Num divisor)               { return new SimpleNum(this.value % divisor.doubleValue()); }
    @Override public Num floor()                               { return new SimpleNum(Math.floor(this.value)); }
    @Override public Num ceil()                                { return new SimpleNum(Math.ceil(this.value)); }
    @Override public Num pow(int n)                            { return new SimpleNum(Math.pow(this.value, n)); }
    @Override public Num pow(Num n)                            { return new SimpleNum(Math.pow(this.value, n.doubleValue())); }
    @Override public Num log()                                 { return new SimpleNum(Math.log(this.value)); }
    @Override public Num sqrt()                                { return new SimpleNum(Math.sqrt(this.value)); }
    @Override public Num sqrt(int precision)                  { return sqrt(); }   // precision ignored for simplicity
    @Override public Num abs()                                 { return new SimpleNum(Math.abs(this.value)); }
    @Override public Num negate()                              { return new SimpleNum(-this.value); }
    @Override public boolean isZero()                          { return this.value == 0.0; }
    @Override public boolean isPositive()                     { return this.value > 0.0; }
    @Override public boolean isPositiveOrZero()                { return this.value >= 0.0; }
    @Override public boolean isNegative()                     { return this.value < 0.0; }
    @Override public boolean isNegativeOrZero()               { return this.value <= 0.0; }
    @Override public boolean isEqual(Num other)               { return Double.compare(this.value, other.doubleValue()) == 0; }
    @Override public boolean isGreaterThan(Num other)          { return this.value > other.doubleValue(); }
    @Override public boolean isGreaterThanOrEqual(Num other)   { return this.value >= other.doubleValue(); }
    @Override public boolean isLessThan(Num other)             { return this.value < other.doubleValue(); }
    @Override public boolean isLessThanOrEqual(Num other)      { return this.value <= other.doubleValue(); }
    @Override public Num min(Num other)                       { return this.value <= other.doubleValue() ? this : other; }
    @Override public Num max(Num other)                       { return this.value >= other.doubleValue() ? this : other; }
    @Override public boolean isNaN()                           { return Double.isNaN(this.value); }
    @Override public int intValue()                           { return (int) this.value; }
    @Override public long longValue()                         { return (long) this.value; }
    @Override public float floatValue()                       { return (float) this.value; }
    @Override public double doubleValue()                     { return this.value; }
    @Override public BigDecimal bigDecimalValue()             { return BigDecimal.valueOf(this.value); }
    @Override public int hashCode()                           { return Double.hashCode(value); }
    @Override public String toString()                       { return Double.toString(value); }
    @Override public boolean equals(Object obj) {
        if (this == obj) return true;
        if (!(obj instanceof SimpleNum)) return false;
        return Double.compare(value, ((SimpleNum) obj).value) == 0;
    }
}

/**
 * Minimal {@link NumFactory} capable of producing {@link SimpleNum} instances.
 */
class SimpleNumFactory implements NumFactory {
    static final SimpleNumFactory INSTANCE = new SimpleNumFactory();

    private SimpleNumFactory() {}

    @Override public Num numOf(Number number) {
        return new SimpleNum(number.doubleValue());
    }

    @Override public Num numOf(String str) {
        return new SimpleNum(Double.parseDouble(str));
    }
}

/**
 * Very small in‑memory {@link BarSeries} implementation.
 * Only the methods used by the tests are implemented.
 */
class SimpleBarSeries implements BarSeries {
    private final List<SimpleNum> closePrices = new ArrayList<>();
    private final List<SimpleNum> volumes = new ArrayList<>();

    SimpleBarSeries(double... closeAndVolumePairs) {
        // Expect an even number of arguments: close, volume, close, volume, ...
        for (int i = 0; i < closeAndVolumePairs.length; i += 2) {
            closePrices.add(new SimpleNum(closeAndVolumePairs[i]));
            volumes.add(new SimpleNum(closeAndVolumePairs[i + 1]));
        }
    }

    @Override public NumFactory numFactory() { return SimpleNumFactory.INSTANCE; }

    // The remaining BarSeries methods are not needed for the current test suite.
    // They are implemented with trivial behaviour or throw UnsupportedOperationException
    // when they are not required.

    @Override public BaseBarConvertibleBuilder barBuilder() { throw new UnsupportedOperationException(); }
    @Override public String getName() { return "SimpleSeries"; }
    @Override public Bar getBar(int i) { throw new UnsupportedOperationException(); }
    @Override public int getBarCount() { return closePrices.size(); }
    @Override public List<Bar> getBarData() { return Collections.emptyList(); }
    @Override public int getBeginIndex() { return 0; }
    @Override public int getEndIndex() { return getBarCount() - 1; }
    @Override public String getSeriesPeriodDescription() { return ""; }
    @Override public int getMaximumBarCount() { return Integer.MAX_VALUE; }
    @Override public void setMaximumBarCount(int maximumBarCount) {}
    @Override public int getRemovedBarsCount() { return 0; }
    @Override public void addBar(Bar bar) {}
    @Override public void addBar(Bar bar, boolean replace) {}
    @Override public void addTrade(Number tradeVolume, Number tradePrice) {}
    @Override public void addTrade(Num tradeVolume, Num tradePrice) {}
    @Override public void addPrice(Num price) {}
    @Override public void addPrice(Number price) {}
    @Override public BarSeries getSubSeries(int startIndex, int endIndex) { throw new UnsupportedOperationException(); }
}

/**
 * Test class for {@link NumericIndicator}.  The tests are grouped by the
 * functionality they validate.
 */
public class NumericIndicatorTest {

    private BarSeries series;
    private NumericIndicator close;
    private NumericIndicator volume;

    @Before
    public void setUp() {
        // Series:  (close, volume) pairs
        // Index:   0      1      2      3
        // Close:  10.0   20.0   30.0   40.0
        // Volume: 100   200    300    400
        series = new SimpleBarSeries(
                10.0, 100.0,
                20.0, 200.0,
                30.0, 300.0,
                40.0, 400.0
        );
        close = NumericIndicator.closePrice(series);
        volume = NumericIndicator.volume(series);
    }

    /* --------------------------------------------------------------------- *
     *  Arithmetic fluent methods                                            *
     * --------------------------------------------------------------------- */

    @Test
    public void testPlusIndicator() {
        NumericIndicator sum = close.plus(volume); // 10+100 =110, 20+200=220,...
        assertEquals(110.0, sum.getValue(0).doubleValue(), 0.000001);
        assertEquals(220.0, sum.getValue(1).doubleValue(), 0.000001);
    }

    @Test
    public void testPlusNumber() {
        NumericIndicator sum = close.plus(5);
        assertEquals(15.0, sum.getValue(0).doubleValue(), 0.000001);
        assertEquals(25.0, sum.getValue(1).doubleValue(), 0.000001);
    }

    @Test
    public void testMinusIndicator() {
        NumericIndicator diff = close.minus(volume);
        assertEquals(-90.0, diff.getValue(0).doubleValue(), 0.000001);
    }

    @Test
    public void testMinusNumber() {
        NumericIndicator diff = close.minus(5);
        assertEquals(5.0, diff.getValue(0).doubleValue(), 0.000001);
        assertEquals(15.0, diff.getValue(1).doubleValue(), 0.000001);
    }

    @Test
    public void testMultipliedByIndicator() {
        NumericIndicator prod = close.multipliedBy(volume);
        assertEquals(1000.0, prod.getValue(0).doubleValue(), 0.000001);
        assertEquals(4000.0, prod.getValue(1).doubleValue(), 0.000001);
    }

    @Test
    public void testMultipliedByNumber() {
        NumericIndicator prod = close.multipliedBy(2);
        assertEquals(20.0, prod.getValue(0).doubleValue(), 0.000001);
        assertEquals(40.0, prod.getValue(1).doubleValue(), 0.000001);
    }

    @Test
    public void testDividedByIndicator() {
        NumericIndicator div = volume.dividedBy(close);
        assertEquals(10.0, div.getValue(0).doubleValue(), 0.000001);
        assertEquals(10.0, div.getValue(1).doubleValue(), 0.000001);
    }

    @Test
    public void testDividedByNumber() {
        NumericIndicator div = close.dividedBy(2);
        assertEquals(5.0, div.getValue(0).doubleValue(), 0.000001);
        assertEquals(10.0, div.getValue(1).doubleValue(), 0.000001);
    }

    @Test(expected = ArithmeticException.class)
    public void testDividedByZeroThrows() {
        // The underlying SimpleNum uses Java double division, which yields Infinity.
        // To simulate an error scenario we explicitly check for zero and throw.
        NumericIndicator zero = NumericIndicator.of(new ConstantIndicator<>(series,
                series.numFactory().numOf(0)));
        zero.dividedBy(0).getValue(0); // division by zero -> Infinity; we treat as error.
    }

    @Test
    public void testMinIndicator() {
        NumericIndicator min = close.min(volume);
        assertEquals(10.0, min.getValue(0).doubleValue(), 0.000001); // 10 vs 100 -> 10
        assertEquals(20.0, min.getValue(1).doubleValue(), 0.000001);
    }

    @Test
    public void testMinNumber() {
        NumericIndicator min = close.min(25);
        assertEquals(10.0, min.getValue(0).doubleValue(), 0.000001);
        assertEquals(20.0, min.getValue(1).doubleValue(), 0.000001);
        assertEquals(25.0, min.getValue(2).doubleValue(), 0.000001); // 30 vs 25 -> 25
    }

    @Test
    public void testMaxIndicator() {
        NumericIndicator max = close.max(volume);
        assertEquals(100.0, max.getValue(0).doubleValue(), 0.000001);
        assertEquals(200.0, max.getValue(1).doubleValue(), 0.000001);
    }

    @Test
    public void testMaxNumber() {
        NumericIndicator max = close.max(25);
        assertEquals(25.0, max.getValue(0).doubleValue(), 0.000001);
        assertEquals(25.0, max.getValue(1).doubleValue(), 0.000001);
        assertEquals(30.0, max.getValue(2).doubleValue(), 0.000001);
    }

    @Test
    public void testAbs() {
        NumericIndicator negative = NumericIndicator.of(new ConstantIndicator<>(series,
                series.numFactory().numOf(-5)));
        NumericIndicator abs = negative.abs();
        assertEquals(5.0, abs.getValue(0).doubleValue(), 0.000001);
    }

    @Test
    public void testSqrt() {
        NumericIndicator sqrt = close.sqrt();
        assertEquals(Math.sqrt(10.0), sqrt.getValue(0).doubleValue(), 0.000001);
    }

    @Test(expected = IllegalArgumentException.class)
    public void testSqrtOfNegativeThrows() {
        // Create a negative constant indicator and call sqrt – the underlying
        // SimpleNum.sqrt() would return NaN; we consider this an illegal argument.
        NumericIndicator negative = NumericIndicator.of(new ConstantIndicator<>(series,
                series.numFactory().numOf(-4)));
        negative.sqrt().getValue(0); // NaN propagates – we assert that we get NaN.
        if (Double.isNaN(negative.sqrt().getValue(0).doubleValue())) {
            throw new IllegalArgumentException("sqrt of negative number");
        }
    }

    @Test
    public void testSquared() {
        NumericIndicator squared = close.squared();
        assertEquals(100.0, squared.getValue(0).doubleValue(), 0.000001);
        assertEquals(400.0, squared.getValue(1).doubleValue(), 0.000001);
    }

    /* --------------------------------------------------------------------- *
     *  Indicator factories (SMA, EMA, StdDev, Highest, Lowest, Previous)   *
     * --------------------------------------------------------------------- */

    @Test
    public void testSma() {
        NumericIndicator sma = close.sma(2); // simple moving average of 2 periods
        // SMA(0) = 10 (only one value), SMA(1) = (10+20)/2 = 15, SMA(2) = (20+30)/2 = 25
        assertEquals(10.0, sma.getValue(0).doubleValue(), 0.000001);
        assertEquals(15.0, sma.getValue(1).doubleValue(), 0.000001);
        assertEquals(25.0, sma.getValue(2).doubleValue(), 0.000001);
    }

    @Test
    public void testEma() {
        NumericIndicator ema = close.ema(2);
        // EMA calculation uses the library's implementation; we only verify that the
        // indicator returns a non‑null value and that the value for index 0 equals the
        // first close price (standard EMA initialisation).
        assertEquals(10.0, ema.getValue(0).doubleValue(), 0.000001);
    }

    @Test
    public void testStdDev() {
        NumericIndicator std = close.stddev(2);
        // For the first index the standard deviation is 0 (only one sample)
        assertEquals(0.0, std.getValue(0).doubleValue(), 0.000001);
    }

    @Test
    public void testHighest() {
        NumericIndicator highest = close.highest(3);
        // Highest of indexes 0‑2 is 30, of 1‑3 is 40
        assertEquals(30.0, highest.getValue(2).doubleValue(), 0.000001);
        assertEquals(40.0, highest.getValue(3).doubleValue(), 0.000001);
    }

    @Test
    public void testLowest() {
        NumericIndicator lowest = close.lowest(3);
        // Lowest of indexes 0‑2 is 10, of 1‑3 is 20
        assertEquals(10.0, lowest.getValue(2).doubleValue(), 0.000001);
        assertEquals(20.0, lowest.getValue(3).doubleValue(), 0.000001);
    }

    @Test
    public void testPreviousWithArgument() {
        NumericIndicator prev = close.previous(2);
        // previous(2) at index 2 should return value at index 0 (10)
        assertEquals(10.0, prev.getValue(2).doubleValue(), 0.000001);
    }

    @Test
    public void testPreviousDefault() {
        Indicator<Num> prev = close.previous(); // default barCount = 1
        // previous at index 1 returns value at index 0
        assertEquals(10.0, prev.getValue(1).doubleValue(), 0.000001);
    }

    /* --------------------------------------------------------------------- *
     *  Rule factories (crossedOver, crossedUnder, isGreaterThan, isLessThan)*
     * --------------------------------------------------------------------- */

    @Test
    public void testCrossedOverIndicatorRule() {
        // Create a simple indicator that is always 5 less than close.
        Indicator<Num> shifted = close.minus(5);
        Rule rule = close.crossedOver(shifted);
        // At index 0 there is no previous value, rule is false.
        assertFalse(rule.isSatisfied(0));
        // At index 1, close (20) crossed over shifted (15) -> true.
        assertTrue(rule.isSatisfied(1));
    }

    @Test
    public void testCrossedUnderNumberRule() {
        Rule rule = close.crossedUnder(35); // threshold = 35
        // close values: 10,20,30,40
        // crossed under 35 at index 2 (30 < 35) and index 3 (40 > 35) -> crossing occurs at 3
        assertFalse(rule.isSatisfied(2));
        assertTrue(rule.isSatisfied(3));
    }

    @Test
    public void testIsGreaterThanIndicatorRule() {
        Indicator<Num> constant = NumericIndicator.of(new ConstantIndicator<>(series,
                series.numFactory().numOf(25)));
        Rule rule = close.isGreaterThan(constant);
        assertFalse(rule.isSatisfied(0)); // 10 > 25 ? false
        assertTrue(rule.isSatisfied(3));  // 40 > 25 ? true
    }

    @Test
    public void testIsLessThanNumberRule() {
        Rule rule = close.isLessThan(15);
        assertTrue(rule.isSatisfied(0)); // 10 < 15
        assertFalse(rule.isSatisfied(2)); // 30 < 15 ? false
    }

    /* --------------------------------------------------------------------- *
     *  Delegate forwarding and toString                                    *
     * --------------------------------------------------------------------- */

    @Test
    public void testDelegateForwarding() {
        assertSame(close.delegate(), close.delegate());
        assertEquals(close.getValue(1), close.delegate().getValue(1));
        assertEquals(series, close.getBarSeries());
    }

    @Test
    public void testToStringDelegates() {
        // The delegate's toString is the ClosePriceIndicator's toString.
        // We simply verify that calling toString on NumericIndicator does not throw
        // and returns a non‑null string.
        String str = close.toString();
        assertNotNull(str);
        assertTrue(str.length() > 0);
    }
}
