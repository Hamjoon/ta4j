\nimport org.ta4j.core.rules.CrossedDownIndicatorRule;\nimport org.ta4j.core.rules.OverIndicatorRule;\nimport org.ta4j.core.rules.UnderIndicatorRule;\nimport org.ta4j.core.Rule;\n\nimport java.time.Duration;\nimport java.time.ZonedDateTime;\nimport java.time.ZoneId;\nimport java.time.Instant;\n\npublic class NumericIndicatorTest {\n\n    private BarSeries series;\n    private BarSeries descendingSeries;\n\n    @Before\n    public void setUp() {\n        series = createSeries();\n        descendingSeries = createDescendingSeries();\n    }\n\n    private BarSeries createSeries() {\n        BarSeries s = new BaseBarSeries(\"test_series\");\n        ZonedDateTime endTime = ZonedDateTime.now();\n        Duration timePeriod = Duration.ofDays(1);\n        for (int i = 0; i < 5; i++) {\n            Num price = DecimalNum.valueOf(i + 1); // 1,2,3,4,5\n            Num volume = DecimalNum.valueOf((i + 1) * 10); // 10,20,30,40,50\n            s.addBar(new BaseBar(timePeriod, endTime.plusDays(i), price, price, price, price, volume));\n        }\n        return s;\n    }\n\n    private BarSeries createDescendingSeries() {\n        BarSeries s = new BaseBarSeries(\"descending_series\");\n        ZonedDateTime endTime = ZonedDateTime.now();\n        Duration timePeriod = Duration.ofDays(1);\n        // values: 5,4,3,2,1\n        for (int i = 0; i < 5; i++) {\n            Num price = DecimalNum.valueOf(5 - i);\n            Num volume = DecimalNum.valueOf((5 - i) * 10);\n            s.addBar(new BaseBar(timePeriod, endTime.plusDays(i), price, price, price, price, volume));\n        }\n        return s;\n    }\n\n    // 1. Test static factory methods\n    @Test\n    public void testOfCreatesNumericIndicator() {\n        ConstantIndicator<Num> constInd = new ConstantIndicator<>(series, DecimalNum.valueOf(5));\n        NumericIndicator numeric = NumericIndicator.of(constInd);\n        assertNotNull(numeric);\n        assertEquals(constInd, numeric.delegate());\n    }\n\n    @Test\n    public void testClosePriceIndicator() {\n        NumericIndicator cp = NumericIndicator.closePrice(series);\n        assertNotNull(cp);\n        assertTrue(cp.delegate() instanceof ClosePriceIndicator);\n        for (int i = 0; i < series.getBarCount(); i++) {\n            Num expected = series.getBar(i).getClosePrice();\n            assertEquals(\"Close price mismatch at index \" + i, expected, cp.getValue(i));\n        }\n    }\n\n    @Test\n    public void testVolumeIndicator() {\n        NumericIndicator vol = NumericIndicator.volume(series);\n        assertNotNull(vol);\n        assertTrue(vol.delegate() instanceof VolumeIndicator);\n        for (int i = 0; i < series.getBarCount(); i++) {\n            Num expected = series.getBar(i).getVolume();\n            assertEquals(\"Volume mismatch at index \" + i, expected, vol.getValue(i));\n        }\n    }\n\n    // 2. Test arithmetic operations with Indicator and Number\n    @Test\n    public void testPlusWithNumber() {\n        NumericIndicator cp = NumericIndicator.closePrice(series);\n        NumericIndicator sum = cp.plus(5);\n        for (int i = 0; i < series.getBarCount(); i++) {\n            Num expected = cp.getValue(i).plus(DecimalNum.valueOf(5));\n            assertEquals(\"Plus with Number failed at index \" + i, expected, sum.getValue(i));\n        }\n    }\n\n    @Test\n    public void testPlusWithIndicator() {\n        NumericIndicator cp = NumericIndicator.closePrice(series);\n        NumericIndicator const5 = NumericIndicator.of(new ConstantIndicator<>(series, DecimalNum.valueOf(5)));\n        NumericIndicator sum = cp.plus(const5);\n        for (int i = 0; i < series.getBarCount(); i++) {\n            Num expected = cp.getValue(i).plus(DecimalNum.valueOf(5));\n            assertEquals(\"Plus with Indicator failed at index \" + i, expected, sum.getValue(i));\n        }\n    }\n\n    @Test\n    public void testMinusWithNumber() {\n        NumericIndicator cp = NumericIndicator.closePrice(series);\n        NumericIndicator diff = cp.minus(2);\n        for (int i = 0; i < series.getBarCount(); i++) {\n            Num expected = cp.getValue(i).minus(DecimalNum.valueOf(2));\n            assertEquals(\"Minus with Number failed at index \" + i, expected, diff.getValue(i));\n        }\n    }\n\n    @Test\n    public void testMinusWithIndicator() {\n        NumericIndicator cp = NumericIndicator.closePrice(series);\n        NumericIndicator const2 = NumericIndicator.of(new ConstantIndicator<>(series, DecimalNum.valueOf(2)));\n        NumericIndicator diff = cp.minus(const2);\n        for (int i = 0; i < series.getBarCount(); i++) {\n            Num expected = cp.getValue(i).minus(DecimalNum.valueOf(2));\n            assertEquals(\"Minus with Indicator failed at index \" + i, expected, diff.getValue(i));\n        }\n    }\n\n    @Test\n    public void testMultipliedByWithNumber() {\n        NumericIndicator cp = NumericIndicator.closePrice(series);\n        NumericIndicator prod = cp.multipliedBy(3);\n        for (int i = 0; i < series.getBarCount(); i++) {\n            Num expected = cp.getValue(i).multipliedBy(DecimalNum.valueOf(3));\n            assertEquals(\"MultipliedBy with Number failed at index \" + i, expected, prod.getValue(i));\n        }\n    }\n\n    @Test\n    public void testMultipliedByWithIndicator() {\n        NumericIndicator cp = NumericIndicator.closePrice(series);\n        NumericIndicator const3 = NumericIndicator.of(new ConstantIndicator<>(series, DecimalNum.valueOf(3)));\n        NumericIndicator prod = cp.multipliedBy(const3);\n        for (int i = 0; i < series.getBarCount(); i++) {\n            Num expected = cp.getValue(i).multipliedBy(DecimalNum.valueOf(3));\n            assertEquals(\"MultipliedBy with Indicator failed at index \" + i, expected, prod.getValue(i));\n        }\n    }\n\n    @Test\n    public void testDividedByWithNumber() {\n        NumericIndicator cp = NumericIndicator.closePrice(series);\n        NumericIndicator quot = cp.dividedBy(2);\n        for (int i = 0; i < series.getBarCount(); i++) {\n            Num expected = cp.getValue(i).dividedBy(DecimalNum.valueOf(2));\n            assertEquals(\"DividedBy with Number failed at index \" + i, expected, quot.getValue(i));\n        }\n    }\n\n    @Test\n    public void testDividedByZero() {\n        NumericIndicator cp = NumericIndicator.closePrice(series);\n        NumericIndicator divZero = cp.dividedBy(0);\n        for (int i = 0; i < series.getBarCount(); i++) {\n            Num result = divZero.getValue(i);\n            // Division by zero should yield NaN according to DecimalNum behavior\n            assertTrue(\"Result of division by zero should be NaN at index \" + i, result.isNaN());\n        }\n    }\n\n    // 3. Test min and max\n    @Test\n    public void testMinWithNumber() {\n        NumericIndicator cp = NumericIndicator.closePrice(series);\n        NumericIndicator min = cp.min(3);\n        for (int i = 0; i < series.getBarCount(); i++) {\n            Num expected = cp.getValue(i).min(DecimalNum.valueOf(3));\n            assertEquals(\"Min with Number failed at index \" + i, expected, min.getValue(i));\n        }\n    }\n\n    @Test\n    public void testMaxWithNumber() {\n        NumericIndicator cp = NumericIndicator.closePrice(series);\n        NumericIndicator max = cp.max(3);\n        for (int i = 0; i < series.getBarCount(); i++) {\n            Num expected = cp.getValue(i).max(DecimalNum.valueOf(3));\n            assertEquals(\"Max with Number failed at index \" + i, expected, max.getValue(i));\n        }\n    }\n\n    @Test\n    public void testMinMaxWithIndicator() {\n        NumericIndicator cp = NumericIndicator.closePrice(series);\n        NumericIndicator const3 = NumericIndicator.of(new ConstantIndicator<>(series, DecimalNum.valueOf(3)));\n        NumericIndicator min = cp.min(const3);\n        NumericIndicator max = cp.max(const3);\n        for (int i = 0; i < series.getBarCount(); i++) {\n            Num expectedMin = cp.getValue(i).min(DecimalNum.valueOf(3));\n            Num expectedMax = cp.getValue(i).max(DecimalNum.valueOf(3));\n            assertEquals(\"Min with Indicator failed at index \" + i, expectedMin, min.getValue(i));\n            assertEquals(\"Max with Indicator failed at index \" + i, expectedMax, max.getValue(i));\n        }\n    }\n\n    // 4. Test unary operations\n    @Test\n    public void testAbs() {\n        // Create a negative constant indicator\n        NumericIndicator negative = NumericIndicator.of(new ConstantIndicator<>(series, DecimalNum.valueOf(-4)));\n        NumericIndicator abs = negative.abs();\n        for (int i = 0; i < series.getBarCount(); i++) {\n            Num expected = DecimalNum.valueOf(-4).abs();\n            assertEquals(\"Abs failed at index \" + i, expected, abs.getValue(i));\n        }\n    }\n\n    @Test\n    public void testSqrtPositive() {\n        NumericIndicator const4 = NumericIndicator.of(new ConstantIndicator<>(series, DecimalNum.valueOf(4)));\n        NumericIndicator sqrt = const4.sqrt();\n        Num expected = DecimalNum.valueOf(4).sqrt();\n        assertEquals(\"Sqrt of positive number\", expected, sqrt.getValue(0));\n    }\n\n    @Test\n    public void testSqrtZero() {\n        NumericIndicator const0 = NumericIndicator.of(new ConstantIndicator<>(series, DecimalNum.valueOf(0)));\n        NumericIndicator sqrt = const0.sqrt();\n        Num expected = DecimalNum.valueOf(0).sqrt();\n        assertEquals(\"Sqrt of zero\", expected, sqrt.getValue(0));\n    }\n\n    @Test\n    public void testSqrtNegative() {\n        NumericIndicator constNeg = NumericIndicator.of(new ConstantIndicator<>(series, DecimalNum.valueOf(-4)));\n        NumericIndicator sqrt = constNeg.sqrt();\n        Num result = sqrt.getValue(0);\n        assertTrue(\"Sqrt of negative should be NaN\", result.isNaN());\n    }\n\n    @Test\n    public void testSquared() {\n        NumericIndicator cp = NumericIndicator.closePrice(series);\n        NumericIndicator squared = cp.squared();\n        for (int i = 0; i < series.getBarCount(); i++) {\n            Num expected = cp.getValue(i).multipliedBy(cp.getValue(i));\n            assertEquals(\"Squared failed at index \" + i, expected, squared.getValue(i));\n        }\n    }\n\n    // 5. Test statistical and moving average indicators\n    @Test\n    public void testSMA() {\n        NumericIndicator cp = NumericIndicator.closePrice(series);\n        NumericIndicator sma = cp.sma(3);\n        // SMA at index 2 (first full window) = (1+2+3)/3 = 2\n        Num expected2 = DecimalNum.valueOf(2);\n        assertEquals(\"SMA at index 2\", expected2, sma.getValue(2));\n        // SMA at index 3 = (2+3+4)/3 = 3\n        Num expected3 = DecimalNum.valueOf(3);\n        assertEquals(\"SMA at index 3\", expected3, sma.getValue(3));\n        // SMA at index 4 = (3+4+5)/3 = 4\n        Num expected4 = DecimalNum.valueOf(4);\n        assertEquals(\"SMA at index 4\", expected4, sma.getValue(4));\n    }\n\n    @Test\n    public void testEMA() {\n        NumericIndicator cp = NumericIndicator.closePrice(series);\n        NumericIndicator ema = cp.ema(3);\n        // EMA calculation with k = 2/(3+1) = 0.5\n        // Index 0: EMA = price0 = 1\n        assertEquals(\"EMA index 0\", DecimalNum.valueOf(1), ema.getValue(0));\n        // Index 1: EMA = price1*0.5 + EMA0*0.5 = 2*0.5 + 1*0.5 = 1.5\n        assertEquals(\"EMA index 1\", DecimalNum.valueOf(1.5), ema.getValue(1));\n        // Index 2: EMA = 3*0.5 + 1.5*0.5 = 2.25\n        assertEquals(\"EMA index 2\", DecimalNum.valueOf(2.25), ema.getValue(2));\n        // Index 3: EMA = 4*0.5 + 2.25*0.5 = 3.125\n        assertEquals(\"EMA index 3\", DecimalNum.valueOf(3.125), ema.getValue(3));\n        // Index 4: EMA = 5*0.5 + 3.125*0.5 = 4.0625\n        assertEquals(\"EMA index 4\", DecimalNum.valueOf(4.0625), ema.getValue(4));\n    }\n\n    @Test\n    public void testStandardDeviation() {\n        NumericIndicator cp = NumericIndicator.closePrice(series);\n        NumericIndicator stddev = cp.stddev(3);\n        // Standard deviation for window [1,2,3] at index 2\n        // Mean = 2, variance = ((1-2)^2+(2-2)^2+(3-2)^2)/3 = (1+0+1)/3 = 0.666666...\n        // StdDev = sqrt(0.666666...) ≈ 0.8164965809\n        Num expected = DecimalNum.valueOf(Math.sqrt(2.0/3.0));\n        // Use tolerance due to floating point\n        assertEquals(\"StdDev at index 2\", expected.doubleValue(), stddev.getValue(2).doubleValue(), 1e-6);\n    }\n\n    @Test\n    public void testHighest() {\n        NumericIndicator cp = NumericIndicator.closePrice(series);\n        NumericIndicator highest = cp.highest(3);\n        // Highest at index 4 (window 3,4,5) = 5\n        assertEquals(\"Highest at index 4\", DecimalNum.valueOf(5), highest.getValue(4));\n        // Highest at index 2 (window 1,2,3) = 3\n        assertEquals(\"Highest at index 2\", DecimalNum.valueOf(3), highest.getValue(2));\n    }\n\n    @Test\n    public void testLowest() {\n        NumericIndicator cp = NumericIndicator.closePrice(series);\n        NumericIndicator lowest = cp.lowest(3);\n        // Lowest at index 4 (window 3,4,5) = 3\n        assertEquals(\"Lowest at index 4\", DecimalNum.valueOf(3), lowest.getValue(4));\n        // Lowest at index 2 (window 1,2,3) = 1\n        assertEquals(\"Lowest at index 2\", DecimalNum.valueOf(1), lowest.getValue(2));\n    }\n\n    @Test\n    public void testPrevious() {\n        NumericIndicator cp = NumericIndicator.closePrice(series);\n        NumericIndicator prev = cp.previous();\n        // previous at index 3 should be value at index 2 (3)\n        assertEquals(\"Previous at index 3\", DecimalNum.valueOf(3), prev.getValue(3));\n        // previous at index 0 should be same as index 0 (no previous)\n        assertEquals(\"Previous at index 0\", cp.getValue(0), prev.getValue(0));\n    }\n\n    // 6. Test rule creation and satisfaction\n    @Test\n    public void testCrossedOverRule() {\n        Numeric