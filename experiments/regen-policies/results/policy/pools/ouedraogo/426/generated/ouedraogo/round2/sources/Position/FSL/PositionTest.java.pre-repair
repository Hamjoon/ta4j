package org.ta4j.core;

import static org.junit.Assert.*;

import java.math.BigDecimal;
import java.time.Instant;
import java.util.Collections;

import org.junit.Test;
import org.ta4j.core.analysis.cost.CostModel;
import org.ta4j.core.analysis.cost.ZeroCostModel;
import org.ta4j.core.num.Num;

/**
 * Unit tests for {@link Position}. The tests use lightweight concrete
 * implementations of {@link Trade} and {@link Num} that are defined only for the
 * purpose of exercising the public API of {@link Position}. No external
 * library classes other than those appearing in the source code or the listed
 * dependency signatures are used.
 */
public class PositionTest {

    /* ---------------------------------------------------------------------- */
    /* Helper concrete implementations                                         */
    /* ---------------------------------------------------------------------- */

    /** Very small {@link Num} implementation based on {@link BigDecimal}. */
    private static final class SimpleNum implements Num {

        private final BigDecimal value;

        SimpleNum(BigDecimal value) {
            this.value = value;
        }

        SimpleNum(double d) {
            this(BigDecimal.valueOf(d));
        }

        @Override
        public Number getDelegate() {
            return value;
        }

        @Override
        public NumFactory getNumFactory() {
            return SimpleNumFactory.INSTANCE;
        }

        @Override
        public String getName() {
            return "SimpleNum";
        }

        @Override
        public Num plus(Num augend) {
            return new SimpleNum(this.value.add(toBigDecimal(augend)));
        }

        @Override
        public Num minus(Num subtrahend) {
            return new SimpleNum(this.value.subtract(toBigDecimal(subtrahend)));
        }

        @Override
        public Num multipliedBy(Num multiplicand) {
            return new SimpleNum(this.value.multiply(toBigDecimal(multiplicand)));
        }

        @Override
        public Num dividedBy(Num divisor) {
            return new SimpleNum(this.value.divide(toBigDecimal(divisor), BigDecimal.ROUND_HALF_EVEN));
        }

        @Override
        public Num remainder(Num divisor) {
            return new SimpleNum(this.value.remainder(toBigDecimal(divisor)));
        }

        @Override
        public Num floor() {
            return new SimpleNum(this.value.setScale(0, BigDecimal.ROUND_FLOOR));
        }

        @Override
        public Num ceil() {
            return new SimpleNum(this.value.setScale(0, BigDecimal.ROUND_CEILING));
        }

        @Override
        public Num pow(int n) {
            return new SimpleNum(this.value.pow(n));
        }

        @Override
        public Num pow(Num n) {
            // not needed for the tests
            throw new UnsupportedOperationException();
        }

        @Override
        public Num log() {
            throw new UnsupportedOperationException();
        }

        @Override
        public Num exp() {
            throw new UnsupportedOperationException();
        }

        @Override
        public Num sqrt() {
            throw new UnsupportedOperationException();
        }

        @Override
        public Num sqrt(java.math.MathContext mathContext) {
            throw new UnsupportedOperationException();
        }

        @Override
        public Num abs() {
            return new SimpleNum(this.value.abs());
        }

        @Override
        public Num negate() {
            return new SimpleNum(this.value.negate());
        }

        @Override
        public boolean isZero() {
            return value.compareTo(BigDecimal.ZERO) == 0;
        }

        @Override
        public boolean isPositive() {
            return value.compareTo(BigDecimal.ZERO) > 0;
        }

        @Override
        public boolean isPositiveOrZero() {
            return value.compareTo(BigDecimal.ZERO) >= 0;
        }

        @Override
        public boolean isNegative() {
            return value.compareTo(BigDecimal.ZERO) < 0;
        }

        @Override
        public boolean isNegativeOrZero() {
            return value.compareTo(BigDecimal.ZERO) <= 0;
        }

        @Override
        public boolean isEqual(Num other) {
            return value.compareTo(toBigDecimal(other)) == 0;
        }

        @Override
        public boolean isGreaterThan(Num other) {
            return value.compareTo(toBigDecimal(other)) > 0;
        }

        @Override
        public boolean isGreaterThanOrEqual(Num other) {
            return value.compareTo(toBigDecimal(other)) >= 0;
        }

        @Override
        public boolean isLessThan(Num other) {
            return value.compareTo(toBigDecimal(other)) < 0;
        }

        @Override
        public boolean isLessThanOrEqual(Num other) {
            return value.compareTo(toBigDecimal(other)) <= 0;
        }

        @Override
        public Num min(Num other) {
            return new SimpleNum(this.value.min(toBigDecimal(other)));
        }

        @Override
        public Num max(Num other) {
            return new SimpleNum(this.value.max(toBigDecimal(other)));
        }

        @Override
        public boolean isNaN() {
            return false;
        }

        @Override
        public int intValue() {
            return value.intValue();
        }

        @Override
        public long longValue() {
            return value.longValue();
        }

        @Override
        public float floatValue() {
            return value.floatValue();
        }

        @Override
        public double doubleValue() {
            return value.doubleValue();
        }

        @Override
        public java.math.BigDecimal bigDecimalValue() {
            return value;
        }

        @Override
        public int hashCode() {
            return value.hashCode();
        }

        @Override
        public String toString() {
            return value.toPlainString();
        }

        @Override
        public boolean equals(Object obj) {
            return (obj instanceof SimpleNum) && ((SimpleNum) obj).value.compareTo(this.value) == 0;
        }

        private static BigDecimal toBigDecimal(Num n) {
            if (n instanceof SimpleNum) {
                return ((SimpleNum) n).value;
            }
            return new BigDecimal(n.doubleValue());
        }
    }

    /** Minimal {@link NumFactory} needed only for {@link Position#zero()}. */
    private static final class SimpleNumFactory implements Num.NumFactory {

        static final SimpleNumFactory INSTANCE = new SimpleNumFactory();

        private SimpleNumFactory() {}

        @Override
        public Num zero() {
            return new SimpleNum(BigDecimal.ZERO);
        }

        @Override
        public Num one() {
            return new SimpleNum(BigDecimal.ONE);
        }

        // The remaining factory methods are not required for the tests.
    }

    /** Simple immutable {@link Trade} implementation. */
    private static final class SimpleTrade implements Trade {

        private final TradeType type;
        private final int index;
        private final Num pricePerAsset;
        private final Num amount;
        private final CostModel costModel;
        private final Num cost; // transaction cost for this trade

        SimpleTrade(TradeType type, int index, Num pricePerAsset, Num amount,
                    CostModel costModel, Num cost) {
            this.type = type;
            this.index = index;
            this.pricePerAsset = pricePerAsset;
            this.amount = amount;
            this.costModel = costModel;
            this.cost = cost;
        }

        @Override
        public TradeType getType() {
            return type;
        }

        @Override
        public int getIndex() {
            return index;
        }

        @Override
        public Num getPricePerAsset() {
            return pricePerAsset;
        }

        @Override
        public Num getNetPrice() {
            // net price = price * amount (no fees)
            return pricePerAsset.multipliedBy(amount);
        }

        @Override
        public Num getAmount() {
            return amount;
        }

        @Override
        public Num getCost() {
            return cost;
        }

        @Override
        public CostModel getCostModel() {
            return costModel;
        }

        @Override
        public Num getValue() {
            // value = price * amount + cost
            return pricePerAsset.multipliedBy(amount).plus(cost);
        }

        @Override
        public boolean isBuy() {
            return type == TradeType.BUY;
        }

        @Override
        public boolean isSell() {
            return type == TradeType.SELL;
        }

        @Override
        public Instant getTime() {
            return Instant.now();
        }

        @Override
        public String getId() {
            return null;
        }

        @Override
        public String getInstrument() {
            return null;
        }

        @Override
        public String getOrderId() {
            return null;
        }

        @Override
        public String getCorrelationId() {
            return null;
        }

        @Override
        public java.util.List<TradeFill> getFills() {
            return Collections.emptyList();
        }

        @Override
        public boolean equals(Object obj) {
            if (!(obj instanceof SimpleTrade)) {
                return false;
            }
            SimpleTrade o = (SimpleTrade) obj;
            return type == o.type && index == o.index &&
                   pricePerAsset.equals(o.pricePerAsset) &&
                   amount.equals(o.amount) &&
                   cost.equals(o.cost) &&
                   costModel.equals(o.costModel);
        }

        @Override
        public int hashCode() {
            return java.util.Objects.hash(type, index, pricePerAsset, amount, cost, costModel);
        }

        @Override
        public String toString() {
            return "Trade[" + type + " idx=" + index + " price=" + pricePerAsset + " amount=" + amount + "]";
        }
    }

    /* ---------------------------------------------------------------------- */
    /* Test data helpers                                                     */
    /* ---------------------------------------------------------------------- */

    private static SimpleNum n(double d) {
        return new SimpleNum(d);
    }

    private static SimpleTrade buy(int idx, double price, double amount) {
        return new SimpleTrade(TradeType.BUY, idx, n(price), n(amount), new ZeroCostModel(), n(0));
    }

    private static SimpleTrade sell(int idx, double price, double amount) {
        return new SimpleTrade(TradeType.SELL, idx, n(price), n(amount), new ZeroCostModel(), n(0));
    }

    /* ---------------------------------------------------------------------- */
    /* Constructor tests                                                       */
    /* ---------------------------------------------------------------------- */

    @Test
    public void testDefaultConstructor() {
        Position p = new Position();
        assertEquals(TradeType.BUY, p.getStartingType());
        assertTrue(p.isNew());
    }

    @Test
    public void testConstructorWithStartingType() {
        Position pBuy = new Position(TradeType.BUY);
        Position pSell = new Position(TradeType.SELL);
        assertEquals(TradeType.BUY, pBuy.getStartingType());
        assertEquals(TradeType.SELL, pSell.getStartingType());
    }

    @Test
    public void testConstructorWithEntryAndExit() {
        Trade entry = buy(0, 10, 2);
        Trade exit = sell(5, 12, 2);
        Position p = new Position(entry, exit);
        assertEquals(entry, p.getEntry());
        assertEquals(exit, p.getExit());
        assertTrue(p.isClosed());
    }

    @Test
    public void testConstructorOpenPosition() {
        Trade entry = buy(0, 10, 5);
        Position p = new Position(entry, new ZeroCostModel(), new ZeroCostModel());
        assertEquals(entry, p.getEntry());
        assertNull(p.getExit());
        assertTrue(p.isOpened());
    }

    /* ---------------------------------------------------------------------- */
    /* Getter and state‑query tests                                            */
    /* ---------------------------------------------------------------------- */

    @Test
    public void testSideAndAmount() {
        Trade entry = sell(3, 15, 3);
        Position p = new Position(entry, new ZeroCostModel(), new ZeroCostModel());
        assertEquals(ExecutionSide.SELL, p.side());
        assertEquals(n(3), p.amount());
        assertEquals(n(15), p.averageEntryPrice());
        assertEquals(entry.getValue(), p.totalEntryCost());
        assertEquals(entry.getCost(), p.totalFees());
    }

    @Test
    public void testIsNewOpenedClosed() {
        Position fresh = new Position();
        assertTrue(fresh.isNew());
        assertFalse(fresh.isOpened());
        assertFalse(fresh.isClosed());

        Trade entry = buy(1, 8, 1);
        Position opened = new Position(entry, new ZeroCostModel(), new ZeroCostModel());
        assertFalse(opened.isNew());
        assertTrue(opened.isOpened());
        assertFalse(opened.isClosed());

        Trade exit = sell(2, 9, 1);
        Position closed = new Position(entry, exit);
        assertFalse(closed.isNew());
        assertFalse(closed.isOpened());
        assertTrue(closed.isClosed());
    }

    /* ---------------------------------------------------------------------- */
    /* operate() tests (new → entry, opened → exit)                           */
    /* ---------------------------------------------------------------------- */

    @Test
    public void testOperateCreatesEntryTradeWhenNew() {
        Position p = new Position(TradeType.BUY);
        Trade t = p.operate(0, n(10), n(1));
        assertNotNull(t);
        assertEquals(TradeType.BUY, t.getType());
        assertEquals(0, t.getIndex());
        assertEquals(p.getEntry(), t);
        assertTrue(p.isOpened());
    }

    @Test
    public void testOperateCreatesExitTradeWhenOpened() {
        Trade entry = buy(0, 10, 2);
        Position p = new Position(entry, new ZeroCostModel(), new ZeroCostModel());
        Trade exit = p.operate(5, n(12), n(2));
        assertNotNull(exit);
        assertEquals(TradeType.SELL, exit.getType());
        assertEquals(5, exit.getIndex());
        assertEquals(p.getExit(), exit);
        assertTrue(p.isClosed());
    }

    @Test(expected = IllegalStateException.class)
    public void testOperateThrowsWhenIndexBeforeEntry() {
        Trade entry = buy(10, 10, 1);
        Position p = new Position(entry, new ZeroCostModel(), new ZeroCostModel());
        // index 5 < entry index 10 -> should throw
        p.operate(5, n(9), n(1));
    }

    @Test
    public void testOperateWithPreBuiltTrade() {
        Position p = new Position(TradeType.BUY);
        SimpleTrade trade = new SimpleTrade(TradeType.BUY, 0, n(10), n(1), new ZeroCostModel(), n(0));
        Trade result = p.operate(trade);
        assertEquals(trade, result);
        assertEquals(trade, p.getEntry());

        SimpleTrade exit = new SimpleTrade(TradeType.SELL, 2, n(12), n(1), new ZeroCostModel(), n(0));
        Trade resultExit = p.operate(exit);
        assertEquals(exit, resultExit);
        assertEquals(exit, p.getExit());
        assertTrue(p.isClosed());
    }

    @Test(expected = IllegalArgumentException.class)
    public void testOperatePreBuiltTradeWrongStartingType() {
        Position p = new Position(TradeType.SELL);
        SimpleTrade wrong = new SimpleTrade(TradeType.BUY, 0, n(10), n(1), new ZeroCostModel(), n(0));
        p.operate(wrong);
    }

    @Test(expected = IllegalArgumentException.class)
    public void testOperatePreBuiltTradeMismatchedCostModel() {
        Position p = new Position(TradeType.BUY);
        CostModel other = new ZeroCostModel(); // same class but a different instance – still equals() returns true,
                                                // however we can create a dummy model that is not equal.
        CostModel dummy = new CostModel() {
            @Override public Num calculate(Position position, int finalIndex) { return n(0); }
            @Override public Num calculate(Position position) { return n(0); }
            @Override public Num calculate(Num price, Num amount) { return n(0); }
            @Override public boolean equals(CostModel otherModel) { return false; }
        };
        SimpleTrade trade = new SimpleTrade(TradeType.BUY, 0, n(10), n(1), dummy, n(0));
        p.operate(trade);
    }

    /* ---------------------------------------------------------------------- */
    /* Equality and hashCode tests                                             */
    /* ---------------------------------------------------------------------- */

    @Test
    public void testEqualsAndHashCode() {
        Trade entry1 = buy(0, 10, 1);
        Trade exit1 = sell(5, 12, 1);
        Position p1 = new Position(entry1, exit1);
        Position p2 = new Position(entry1, exit1);
        Position p3 = new Position(buy(0, 10, 1), sell(6, 12, 1)); // different exit index

        assertEquals(p1, p2);
        assertEquals(p1.hashCode(), p2.hashCode());
        assertNotEquals(p1, p3);
    }

    @Test
    public void testEqualsWithNulls() {
        Position pNew = new Position();
        Position pOtherNew = new Position();
        assertEquals(pNew, pOtherNew);
    }

    /* ---------------------------------------------------------------------- */
    /* Profit / loss calculations                                            */
    /* ---------------------------------------------------------------------- */

    @Test
    public void testProfitClosedBuyPositionPositive() {
        Trade entry = buy(0, 10, 2); // cost = 0
        Trade exit = sell(5, 12, 2);
        Position p = new Position(entry, exit);
        // gross profit = (12*2) - (10*2) = 24 - 20 = 4
        // transaction & holding cost = 0 (ZeroCostModel)
        assertEquals(n(4), p.getProfit());
        assertTrue(p.hasProfit());
        assertFalse(p.hasLoss());
        assertEquals(n(4), p.getGrossProfit());
        assertEquals(n(1.2), p.getGrossReturn()); // 12/10 = 1.2
    }

    @Test
    public void testProfitClosedBuyPositionNegative() {
        Trade entry = buy(0, 15, 1);
        Trade exit = sell(3, 10, 1);
        Position p = new Position(entry, exit);
        // gross profit = (10*1) - (15*1) = -5
        assertEquals(n(-5), p.getProfit());
        assertFalse(p.hasProfit());
        assertTrue(p.hasLoss());
        assertEquals(n(-5), p.getGrossProfit());
        assertEquals(n(0.6666666666666666), p.getGrossReturn()); // 10/15
    }

    @Test
    public void testProfitClosedSellPositionPositive() {
        Trade entry = sell(0, 20, 3);
        Trade exit = buy(4, 18, 3);
        Position p = new Position(entry, exit);
        // For short (sell first) gross profit = entryValue - exitValue = (20*3) - (18*3) = 6
        assertEquals(n(6), p.getProfit());
        assertTrue(p.hasProfit());
        assertEquals(n(0.9), p.getGrossReturn()); // (exit/entry - 1) negated + 1 = 0.9
    }

    @Test
    public void testProfitClosedSellPositionNegative() {
        Trade entry = sell(0, 30, 1);
        Trade exit = buy(2, 35, 1);
        Position p = new Position(entry, exit);
        // loss = (30 - 35) = -5
        assertEquals(n(-5), p.getProfit());
        assertTrue(p.hasLoss());
        assertEquals(n(1.1666666666666667), p.getGrossReturn()); // 1 - ((35/30 -1)) = 0.933... + 1 = 1.1667
    }

    @Test
    public void testOpenPositionProfitIsZero() {
        Trade entry = buy(0, 10, 1);
        Position p = new Position(entry, new ZeroCostModel(), new ZeroCostModel());
        assertEquals(n(0), p.getProfit());
        assertEquals(n(0), p.getGrossProfit());
        assertEquals(n(0), p.getGrossReturn());
    }

    /* ---------------------------------------------------------------------- */
    /* Position cost calculations (zero‑cost model)                           */
    /* ---------------------------------------------------------------------- */

    @Test
    public void testPositionCostZeroWhenUsingZeroCostModel() {
        Trade entry = buy(0, 5, 2);
        Trade exit = sell(3, 7, 2);
        Position closed = new Position(entry, exit);
        assertEquals(n(0), closed.getPositionCost());
        assertEquals(n(0), closed.getPositionCost(10));
    }

    @Test
    public void testHoldingCostZeroModel() {
        Trade entry = buy(0, 5, 2);
        Position open = new Position(entry, new ZeroCostModel(), new ZeroCostModel());
        assertEquals(n(0), open.getHoldingCost());
        assertEquals(n(0), open.getHoldingCost(5));
    }

    /* ---------------------------------------------------------------------- */
    /* toString sanity check                                                   */
    /* ---------------------------------------------------------------------- */

    @Test
    public void testToStringContainsEntryAndExit() {
        Trade entry = buy(1, 11, 1);
        Trade exit = sell(2, 12, 1);
        Position p = new Position(entry, exit);
        String s = p.toString();
        assertTrue(s.contains("Entry:"));
        assertTrue(s.contains("exit:"));
    }
}
